# ========================================================
# Telegram Auto-Posting Bot - Environment Variables
# ========================================================
# Bu faylni nusxalab .env nomi bilan saqlang va
# o'z qiymatlaringizni kiriting.
# ========================================================

# --- Telegram ---
# @BotFather dan olingan bot tokeni
BOT_TOKEN=your_bot_token_here

# Kanal username yoki ID (masalan: @NLMINI_12 yoki -1001234567890)
CHANNEL_ID=@NLMINI_12

# --- AI Provider (birini tanlang) ---
# OpenAI uchun
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) uchun (ixtiyoriy)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Qaysi AI ishlatilsin: "openai" yoki "anthropic"
AI_PROVIDER=openai

# --- Scheduler ---
# RSS tekshirish oralig'i (daqiqalarda)
FETCH_INTERVAL_MINUTES=30

# Postlar orasidagi kechikish (soniyalarda, Telegram Rate Limit uchun)
POST_DELAY_SECONDS=5

# Bir siklda yuborish mumkin bo'lgan maksimal post soni
MAX_POSTS_PER_CYCLE=5

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/news_bot.db

# --- Logging ---
LOG_LEVEL=INFO
